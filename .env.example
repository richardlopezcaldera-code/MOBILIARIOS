# Copia este archivo como `.env.local` y completa los valores.
# `.env.local` NO se sube a git — nunca compartas estas credenciales por chat.

# --- Jumpseller API -------------------------------------------------------
# Panel de Jumpseller → Configuración → API. Genera el token ahí.
# Sin estos dos valores el sitio funciona igual, pero con el catálogo
# congelado del snapshot en src/data/.
JUMPSELLER_LOGIN=
JUMPSELLER_AUTHTOKEN=

# --- Webhook de refresco --------------------------------------------------
# Inventa una cadena larga y aleatoria. Va también en la URL del webhook
# que configuras en Jumpseller:
#   https://TU-DOMINIO/api/revalidate?secret=ESTE_VALOR
REVALIDATE_SECRET=
